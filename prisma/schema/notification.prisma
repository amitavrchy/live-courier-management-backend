model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  description String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user Users @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
