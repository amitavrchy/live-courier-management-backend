# Copy this file to `.env` and fill in values.
# PostgreSQL 15+ is required.

# App
PORT=3000
NODE_ENV=development

# Used by Nest / Prisma when running on the host (npm run start:dev)
# Point at the dockerized Postgres from docker-compose.dev.yml:
DATABASE_URL="postgresql://andyesqo:andyesqo@localhost:5433/andyesqo"

# Docker Compose (app + postgres)
# Host port 5433 avoids conflict when another Postgres already uses 5432.
POSTGRES_USER=andyesqo
POSTGRES_PASSWORD=andyesqo
POSTGRES_DB=andyesqo
POSTGRES_PORT=5433

# Set to false to skip prisma db init on container start
RUN_DB_INIT=true
