# Copy this file to `.env` and fill in values.
# PostgreSQL 15+ is required.

# App
PORT=3001
NODE_ENV=development
APP_LOGIN_URL=http://localhost:3001/docs

# JWT
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# Used by Nest / Prisma when running on the host (npm run start:dev)
# Point at the dockerized Postgres from docker-compose.dev.yml:
DATABASE_URL="postgresql://andyesqo:andyesqo@localhost:5433/andyesqo"

# Docker Compose (app + postgres)
# Host port 5433 avoids conflict when another Postgres already uses 5432.
POSTGRES_USER=andyesqo
POSTGRES_PASSWORD=andyesqo
POSTGRES_DB=andyesqo
POSTGRES_PORT=5433

# Optional: registry image for deployment (otherwise Docker builds locally).
# APP_IMAGE=ghcr.io/amitavrchy/live-courier-management-backend:latest

# Set to false when migrations are applied separately before app startup.
RUN_DB_INIT=true

# Seed accounts (used by `npm run db:seed`)
SEED_TENANT_ID=00000000-0000-4000-8000-000000000001
SEED_TENANT_NAME=AndYesQo Demo Tenant
SEED_TENANT_SUPPORT_EMAIL=support@andyesqo.local
SEED_PLATFORM_ADMIN_EMAIL=platform.admin@andyesqo.local
SEED_PLATFORM_ADMIN_PASSWORD=PlatformAdmin@123
SEED_BUSINESS_ADMIN_EMAIL=business.admin@andyesqo.local
SEED_BUSINESS_ADMIN_PASSWORD=BusinessAdmin@123

# SMTP (required to actually send emails; without these, credentials are logged only)
# For Gmail: use an App Password (no spaces) and SMTP_PORT=587
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your16charapppassword
# SMTP_FROM=AndYesQo <you@gmail.com>

# Redis (BullMQ — used by the universal email queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
